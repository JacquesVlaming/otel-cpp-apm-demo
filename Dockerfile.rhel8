# Build and run preloader + dice-server on RHEL 8 (Rocky 8) to test segfault fix.
# Note: OpenTelemetry C++ SDK build may fail on RHEL 8 (gmake error at ~33%).
# The preloader fix (no std::cout in constructor, use write()) is in preload_tracer.cpp.
# Minimal repro without OTEL: see pre_loader/repro-scenarios/rhel8-preload-ctor-test/
# Usage: docker build -f Dockerfile.rhel8 -t otel-dice-rhel8 . && docker run --rm otel-dice-rhel8
FROM rockylinux:8 AS builder

RUN dnf install -y gcc-c++ cmake make git openssl-devel zlib-devel \
    && dnf clean all

WORKDIR /build

# Oat++ (for dice-server)
RUN git clone --depth 1 https://github.com/oatpp/oatpp.git -b 1.3.0-latest \
    && cd oatpp && mkdir build && cd build \
    && cmake .. && make -j$(nproc) \
    && cd /build

# OpenTelemetry C++ SDK (OTLP HTTP)
RUN git clone --depth 1 https://github.com/open-telemetry/opentelemetry-cpp.git \
    && cd opentelemetry-cpp && mkdir build && cd build \
    && cmake .. \
        -DCMAKE_INSTALL_PREFIX=/opt/otel-cpp \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DWITH_EXAMPLES=OFF \
        -DWITH_OTLP_GRPC=OFF \
        -DWITH_OTLP_HTTP=ON \
        -DBUILD_TESTING=OFF \
        -DWITH_BENCHMARK=OFF \
        -DWITH_FUNC_TESTS=OFF \
    && cmake --build . -j$(nproc) && cmake --install . \
    && cd /build && rm -rf opentelemetry-cpp

# Dice server
COPY roll-dice /build/roll-dice
RUN cd /build/roll-dice && mkdir build && cd build \
    && cmake .. -DOATPP_ROOT=/build/oatpp \
    && cmake --build .

# Preload tracer .so (same flags as main Dockerfile)
RUN cd /build/roll-dice \
    && g++ -std=c++17 -shared -fPIC preload_tracer.cpp -o preload_tracer.so \
        -I/opt/otel-cpp/include \
        -L/opt/otel-cpp/lib -Wl,-rpath,/opt/otel-cpp/lib \
        -lopentelemetry_trace \
        -lopentelemetry_exporter_otlp_http \
        -lopentelemetry_resources \
        -lopentelemetry_common \
        -ldl -lpthread

# Minimal test: only load the .so (triggers constructors/destructors only)
RUN echo '#include <dlfcn.h>\n#include <stdio.h>\n#include <stdlib.h>\nint main() {\n  void* h = dlopen("preload_tracer.so", RTLD_NOW);\n  if (!h) { fprintf(stderr, "dlopen: %s\\n", dlerror()); return 1; }\n  printf("dlopen ok\\n");\n  dlclose(h);\n  printf("dlclose ok\\n");\n  return 0;\n}' > /build/test_ctor.c \
    && gcc -o /build/test_preload_ctor /build/test_ctor.c -ldl

# Runtime (RHEL 8)
FROM rockylinux:8

RUN dnf install -y ca-certificates curl && dnf clean all

COPY --from=builder /opt/otel-cpp /opt/otel-cpp
COPY --from=builder /build/roll-dice/build/dice-server /app/dice-server
COPY --from=builder /build/roll-dice/preload_tracer.so /app/preload_tracer.so
COPY --from=builder /build/test_preload_ctor /app/test_preload_ctor

ENV LD_LIBRARY_PATH=/opt/otel-cpp/lib
ENV OTEL_SERVICE_NAME=dice-server
ENV OTEL_SERVER_ADDRESS=0.0.0.0
ENV OTEL_SERVER_PORT=8080
# Avoid OTEL init in lazy path for constructor-only test
ENV OTEL_EXPORTER_OTLP_ENDPOINT=""

WORKDIR /app

# Run minimal test first (constructor only); then optional dice with preload
CMD ["/bin/bash", "-c", "echo '=== Test 1: load .so only (constructors) ===' && /app/test_preload_ctor; echo '=== Test 2: dice-server with LD_PRELOAD ===' && LD_PRELOAD=/app/preload_tracer.so /app/dice-server"]
